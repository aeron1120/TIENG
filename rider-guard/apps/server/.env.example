# 복사해서 .env 로 쓰세요. 값이 없으면 오른쪽 기본값.
PORT=4000
DB_PATH=./data/rider-guard.db
# SMS 위치 링크의 기준 주소 — 휴대폰에서 열려야 하므로 같은 Wi-Fi 의 PC IP 또는 공개 도메인
PUBLIC_BASE_URL=http://localhost:4000
# 취소 카운트다운 30~60초 (설계문서 4.3)
COUNTDOWN_SECONDS=30
# 비상연락 1순위 → 2순위 문자 간격(초)
CONTACT_STAGGER_SECONDS=60
SESSION_MAX_HOURS=12
# 관제 콘솔(/ops) 토큰. 운영에서는 24자 이상 필수
OPS_TOKEN=dev-ops-token
CENTER_PHONE=0000
# 119 문자 자동 신고 — 로드맵 Phase 3 전까지 false
ENABLE_119_SMS=false
