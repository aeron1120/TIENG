    "typecheck": "tsc --noEmit",
    "fake-detector": "node scripts/fake-detector.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~6.0.3"
  }
}
