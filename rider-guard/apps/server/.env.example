# 복사해서 .env 로 쓰세요. 값이 없으면 오른쪽 기본값.
PORT=4000
# 저장소. 비우면 로컬 파일(file:./data/rider-guard-v2.db). 클라우드는 Turso 주소와 토큰
# 예) DATABASE_URL=libsql://rider-guard-<계정>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# 서버의 공개 주소 — SMS 위치 링크와 SNS 로그인 콜백 주소가 이걸 기준으로 만들어진다.
# 휴대폰에서 열려야 하므로 같은 Wi-Fi 의 PC IP 또는 공개 도메인. 구글 로그인은 https 주소여야 한다(localhost 제외)
# (Render 에서는 비워 두면 Render 가 주는 RENDER_EXTERNAL_URL 을 쓴다)
PUBLIC_BASE_URL=http://localhost:4000

# SNS 로그인 — 제공자마다 두 값이 다 있어야 앱에 그 버튼이 보인다. 비워 두면 이메일 로그인만.
# 각 개발자 콘솔에 등록할 콜백(Redirect URI): <PUBLIC_BASE_URL>/auth/oauth/<kakao|naver|google>/callback
# 카카오 developers.kakao.com — 앱 키의 'REST API 키', 보안 > Client Secret(사용함)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 앱 키의 'Admin 키' — 탈퇴한 회원의 카카오 연결 끊기(카카오 정책상 필수). 서버 밖으로 내보내지 말 것
KAKAO_ADMIN_KEY=
# 네이버 developers.naver.com — 애플리케이션의 Client ID / Client Secret (검수 전에는 등록한 테스트 ID 만 로그인 가능)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글 console.cloud.google.com — OAuth 클라이언트 ID(유형: 웹 애플리케이션)의 ID / 보안 비밀
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SNS 로그인 뒤 돌아갈 앱 딥링크 스킴 (apps/rider/app.json 의 scheme)
APP_SCHEME=riderguard
# 취소 카운트다운 30~60초 (설계문서 4.3)
COUNTDOWN_SECONDS=30
# 비상연락 1순위 → 2순위 문자 간격(초)
CONTACT_STAGGER_SECONDS=60
SESSION_MAX_HOURS=12
# 운영 모니터(/ops, 읽기 전용) 토큰. 운영에서는 24자 이상 필수
OPS_TOKEN=dev-ops-token
# 지표 판정으로 사고를 여는가 — 로드맵 Phase 1(기록만)이면 false. 비워 두면 개발 true / 운영 false
DETECTION_ENABLED=
# 판정 임계값 — 사고 후보 = 충격 AND (회전 OR ΔV OR 기울기). 헬멧 IMU 시뮬레이션에서 고른 값이라 실측으로 다시 정한다
# 충격: 헬멧 합성 가속도 (g)
IMPACT_G_MIN=4
# 보조: 헬멧 합성 각속도 (deg/s)
ROTATION_DPS_MIN=600
# 보조: IMU 추정 150ms ΔV (m/s)
DV_MIN=3
# 보조: IMU 추정 헬멧 기울기 절댓값 (deg)
BANK_MIN_DEG=75
# 사후 무동작: 충격 30초 뒤까지 이어진 무동작 시간 (s)
STILL_QUIET_MIN_S=20
# 푸시 — expo(기본) 또는 console(서버 콘솔에만 출력). EAS 대시보드에서 푸시 보안을 켰으면 액세스 토큰
PUSH_PROVIDER=
EXPO_ACCESS_TOKEN=
