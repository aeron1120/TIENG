{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rider-guard-api-ejwy.onrender.com",
        "EXPO_PUBLIC_SHOW_DEV_TOOLS": "true"
      }
    },
    "production": {}
  }
}
