# 이륜차 사고 감지 파이프라인. 부팅 시 자동 시작하고 죽으면 되살아난다.
#
#   sudo cp deploy/moto-sensing.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now moto-sensing
#   journalctl -u moto-sensing -f
#
# 경로와 사용자가 다르면 아래 User/WorkingDirectory 를 고칠 것.

[Unit]
Description=Moto crash sensing pipeline
# 카메라·SPI 가 올라온 뒤에 뜨게 한다.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
# 카메라와 SPI/GPIO 접근 권한. 사용자가 이 그룹에 없으면 어댑터가 start 에서 죽는다.
SupplementaryGroups=video spi gpio

WorkingDirectory=/home/pi/TIENG
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/TIENG/.venv/bin/python -m core.pipeline \
    --config config/default.yaml --source live

# 죽으면 되살린다. 다만 설정 오류로 무한 재시작하며 로그를 덮지 않도록
# 5분에 5번을 넘으면 멈추고 사람을 기다린다.
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# 종료 신호를 받으면 recorder 가 parquet 를 닫고 나갈 시간을 준다. 여기서 바로
# SIGKILL 하면 마지막 세션이 반쯤 쓰다 만 파일로 남아 리플레이가 안 된다 (§8, §9).
KillSignal=SIGINT
TimeoutStopSec=20

# SD 카드 수명을 위해 로그는 journal 로만 보낸다. 주행 데이터는 sessions/ 에 쌓인다.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
