{
  "name": "@rider-guard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "fake-detector": "node scripts/fake-detector.ts",
    "sim": "node scripts/sim-bridge.ts",
    "presentation": "node scripts/presentation-preview.ts",
    "lint": "eslint ."
